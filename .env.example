# =====================================================================
# VENARES AULAS - variaveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# =====================================================================

# --- Zoom (Server-to-Server OAuth App no App Marketplace) ---------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# "Secret Token" da aba Feature > Event Subscriptions do mesmo app
ZOOM_SECRET_TOKEN=

# --- Anthropic (geracao do resumo) -------------------------------------
ANTHROPIC_API_KEY=

# --- Google Drive ------------------------------------------------------
# Opcao A (recomendada para o "Meu Drive" pessoal): OAuth do proprio usuario.
# Rode `python scripts/autorizar_google.py` para gerar o refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Opcao B (para Drive Compartilhado / Workspace): conta de servico.
# Caminho para o JSON da service account. Se preenchido, tem prioridade.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Opcional: e-mail a personificar via delegacao em todo o dominio (Workspace)
GOOGLE_DELEGAR_PARA=

# --- WhatsApp (aviso para o responsavel de TI) -------------------------
# provedor definido em config/config.yaml: "meta" ou "twilio"

# Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Aplicacao ---------------------------------------------------------
# Chave para os endpoints administrativos (/admin/*). Gere uma aleatoria.
ADMIN_API_KEY=
VENARES_CONFIG=config/config.yaml
VENARES_GLOSSARIO=config/glossario.yaml
VENARES_DIR_TRABALHO=trabalho
VENARES_BANCO=dados/venares.db
LOG_LEVEL=INFO
